# Copy to .env and fill in the values. The server reads .env before it starts;
# anything already set in the process environment takes precedence.

# Domain names accepted by the server, comma-separated, no scheme and no port.
# localhost, 127.0.0.1, [::1] and this machine's own addresses are always accepted.
LAN_HOSTS=
# Set to 1 to accept every Host name and every source address, for example behind a proxy.
ALLOW_ALL=

# Required. Needed to upload, delete files and manage saved texts.
HOST_UPLOAD_PASSWORD=

# Seconds an IP is refused after one wrong password.
HOST_PASSWORD_RETRY_SECONDS=60

# Folder for uploaded files and saved texts, relative to the project root.
HOST_UPLOAD_DIR=uploads

# PORT=3000
# HOST=0.0.0.0
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# Optional ceilings. Bytes for the two sizes, a count for the saved texts.
# HOST_MAX_FILE_SIZE=4294967296
# HOST_MAX_TOTAL_SIZE=107374182400
# HOST_MAX_MESSAGES=200
